# Copy to .env and provide secrets locally; never commit .env.

# AI Agent LLM - Gemini is the default runtime provider.
DATT_AGENT_LLM_PROVIDER=google_genai
DATT_AGENT_LLM_MODEL=gemini-3.8-flash
GEMINI_API_KEY=
# GOOGLE_API_KEY is also accepted as an alternative to GEMINI_API_KEY.
# DATT_AGENT_LLM_TEMPERATURE=0.1
# DATT_AGENT_LLM_TIMEOUT_SECONDS=30
# DATT_AGENT_LLM_MAX_RETRIES=3

POSTGRES_USER=datt
POSTGRES_DB=datt
POSTGRES_PASSWORD=
POSTGRES_PORT=5432
# Optional db-tools override. Inside Docker use hostname postgres, port 5432.
# Leave empty to construct a URL safely from the POSTGRES_* settings.
DATT_DATABASE_URL=
# Persistent Colab deployments require external services (never commit credentials).
# DATT_REQUIRE_PERSISTENCE=1
# DATT_STORAGE_BACKEND=external
# DATT_STORAGE_URL=<provider>://<bucket-or-container>/<prefix>
# DATT_STORAGE_OPTIONS={}
# DATT_STORAGE_CACHE=/content/datt-media-cache
