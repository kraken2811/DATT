# Copy to .env and provide secrets locally; never commit .env.

# -----------------------------------------------------------------------------
# AI Agent LLM
# -----------------------------------------------------------------------------
# Supported providers: google_genai, openai, mock
DATT_AGENT_LLM_PROVIDER=google_genai
DATT_AGENT_LLM_MODEL=gemini-3.8-flash
GEMINI_API_KEY=
# GOOGLE_API_KEY is also accepted as an alternative to GEMINI_API_KEY.
# OPENAI_API_KEY=

# Optional LLM tuning
# DATT_AGENT_LLM_TEMPERATURE=0.1
# DATT_AGENT_LLM_TIMEOUT_SECONDS=30
# DATT_AGENT_LLM_MAX_RETRIES=3

# Optional fallback provider/model. Configure the matching API key above.
# DATT_AGENT_LLM_FALLBACK_PROVIDER=openai
# DATT_AGENT_LLM_FALLBACK_MODEL=gpt-4o-mini

# -----------------------------------------------------------------------------
# AI Agent execution safety
# -----------------------------------------------------------------------------
# AGENT_RECURSION_LIMIT=15
# AGENT_TIMEOUT_SEC=30
# AGENT_TOOL_TIMEOUT_SEC=10
# AGENT_MAX_TOOL_REPEATS=2
# DATT_AGENT_MAX_TOOL_CYCLES=4
# DATT_AGENT_MAX_TOTAL_TOOL_CALLS=8

# Conversation/context trimming
# AGENT_MAX_HISTORY_MESSAGES=20
# AGENT_TRIM_THRESHOLD_TOKENS=4000

# -----------------------------------------------------------------------------
# AI Agent RAG / Knowledge Base
# -----------------------------------------------------------------------------
# Defaults are aligned with src/agent/config.py.
# DATT_AGENT_EMBEDDING_PROVIDER=fastembed
# DATT_AGENT_EMBEDDING_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
# DATT_AGENT_EMBEDDING_DIM=384
# AGENT_RAG_CHUNK_SIZE=800
# AGENT_RAG_CHUNK_OVERLAP=100
# AGENT_RAG_TOP_K=4
# AGENT_RAG_SCORE_THRESHOLD=0.50

# -----------------------------------------------------------------------------
# AI Agent authentication / tenant isolation
# -----------------------------------------------------------------------------
# Production Agent deployments should enable strict authentication and use a
# signing secret of at least 32 characters. Never commit a real secret.
# DATT_AGENT_AUTH_SECRET=
# DATT_SECRET_KEY=
# DATT_STRICT_AUTH=1

# Only configure when requests arrive through a trusted reverse proxy.
# DATT_TRUSTED_PROXY_SECRET=

# -----------------------------------------------------------------------------
# PostgreSQL / persistence
# -----------------------------------------------------------------------------
POSTGRES_USER=datt
POSTGRES_DB=datt
POSTGRES_PASSWORD=
POSTGRES_PORT=5432

# Optional db-tools override. Inside Docker use hostname postgres, port 5432.
# Leave empty to construct a URL safely from the POSTGRES_* settings.
DATT_DATABASE_URL=

# Persistent deployments require PostgreSQL-backed Agent conversation history.
# DATT_REQUIRE_PERSISTENCE=1

# -----------------------------------------------------------------------------
# External storage
# -----------------------------------------------------------------------------
# Persistent Colab deployments require external services (never commit credentials).
# DATT_STORAGE_BACKEND=external
# DATT_STORAGE_URL=<provider>://<bucket-or-container>/<prefix>
# DATT_STORAGE_OPTIONS={}
# DATT_STORAGE_CACHE=/content/datt-media-cache
